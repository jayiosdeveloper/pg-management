<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground.
  Adaptive icons get a system-rendered background (navy) and a mask
  (circle / squircle / etc.), so the icon here is just the building
  glyph sized to fit the inner safe zone (~66dp of the 108dp viewport).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Roof (white peak) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,28 L82,50 L26,50 Z" />

    <!-- Building body (white) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,50 L78,50 L78,84 L30,84 Z" />

    <!-- Roof accent (subtle inner stripe) -->
    <path
        android:fillColor="#3B5BFF"
        android:pathData="M54,34 L74,50 L34,50 Z" />

    <!-- Lit windows (cyan) — 2x2 grid -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="M37,57 L47,57 L47,66 L37,66 Z" />
    <path
        android:fillColor="#22D3EE"
        android:pathData="M61,57 L71,57 L71,66 L61,66 Z" />
    <path
        android:fillColor="#22D3EE"
        android:pathData="M37,70 L47,70 L47,79 L37,79 Z" />
    <path
        android:fillColor="#22D3EE"
        android:pathData="M61,70 L71,70 L71,79 L61,79 Z" />

    <!-- Centered door (purple) -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M49,72 L59,72 L59,84 L49,84 Z" />
</vector>
