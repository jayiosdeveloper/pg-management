# ============ SERVER ============
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ============ JWT ============
# Use long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=30d

# ============ SUPABASE ============
# From Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Service role key has full DB access - never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============ CLOUDINARY ============
# From Cloudinary dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=pg-management

# ============ FIREBASE (Phase 8) ============
# Path to service account JSON - obtained from Firebase console
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ============ INITIAL ADMIN ============
# Used by the seed script to bootstrap the first admin
SEED_ADMIN_EMAIL=admin@pg.local
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Super Admin

# ============ CORS ============
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
